{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mun/react": ["packages/react/dist/index.d.ts"],
      "@mun/react/*": ["packages/react/dist/*"]
    }
  },
  "files": [
    "src/index.ts",
    "src/legacy.ts",
    "src/compiler/index.ts",
    "src/core.ts",
    "src/experimental.ts",
    "src/mun.ts",
    "src/closures.ts",
    "src/state.ts",
    "src/types.ts",
    "src/react-types.ts",
    "src/astro.ts",
    "src/vite.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts"
  ]
}
