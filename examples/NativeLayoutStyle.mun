struct NativeLayoutStyle: View {
  var body: some View {
    VStack(spacing: 12) {
      HStack(alignment: .bottom, spacing: 10) {
        Rectangle()
          .frame(width: 40, height: 20)
          .background("#FF0000")
          .cornerRadius(5)
        Rectangle()
          .frame(width: 60, height: 30)
          .background("#00FF00")
          .opacity(0.5)
      }

      ZStack() {
        Rectangle()
          .frame(width: 120, height: 80)
          .background("#112233")
          .cornerRadius(12)
        Rectangle()
          .frame(width: 40, height: 20)
          .background("#445566")
      }

      Text("Styled")
        .foregroundColor("#ABCDEF")
    }
    .frame(width: 240, height: 220)
    .padding(10)
    .background("#010203")
  }
}

export default NativeLayoutStyle()
