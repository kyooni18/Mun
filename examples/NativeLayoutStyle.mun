@main
struct NativeLayoutStyle: View {
  var body: some View {
    VStack(spacing: 12) {
      HStack(alignment: .bottom, spacing: 10) {
        Rectangle()
          .fill(Color("#FF0000"))
          .frame(width: 40, height: 20)
          .cornerRadius(5)
        Rectangle()
          .fill(Color("#00FF00"))
          .frame(width: 60, height: 30)
          .opacity(0.5)
      }

      ZStack {
        RoundedRectangle(cornerRadius: 12)
          .fill(Color("#112233"))
          .frame(width: 120, height: 80)
        Rectangle()
          .fill(Color("#445566"))
          .frame(width: 40, height: 20)
      }

      Text("Styled")
        .foregroundStyle(Color("#ABCDEF"))
    }
    .frame(width: 240, height: 220)
    .padding(10)
    .background(Color("#010203"))
  }
}
