struct SettingRow: View {
  let title: String
  @Binding var isOn: Bool

  var body: some View {
    HStack {
      Toggle(title, isOn: $isOn)
      Spacer()
      Text(isOn ? "On" : "Off")
    }
  }
}

@main
struct NativeSettingsPane: View {
  @State var wifi: Bool = false
  @State var bluetooth: Bool = true
  @State var password: String = "pa55"
  @State var synced: Int = 3
  @State var visits: Int = 0

  var body: some View {
    VStack(alignment: .leading, spacing: 8) {
      SettingRow(title: "Wi-Fi", isOn: $wifi)
      SettingRow(title: "Bluetooth", isOn: $bluetooth)
      Divider()
      SecureField("Password", text: $password)
      ProgressView("Sync", value: synced, total: 4)
      if wifi {
        Text("Networks")
          .onAppear { visits = visits + 1 }
          .onDisappear { visits = visits + 10 }
      }
      Text("Visits \(visits)")
    }
    .frame(width: 420)
  }
}
