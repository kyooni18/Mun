struct ShapeStrip: View {
  var body: some View {
    HStack(alignment: .bottom, spacing: 8) {
      Circle()
        .frame(width: 30, height: 30)
        .foregroundStyle(Color("#00FF00"))

      Capsule()
        .frame(width: 60, height: 20)
        .foregroundStyle(LinearGradient(colors: [Color("#00FFFF"), Color("#FF00FF")], startPoint: .leading, endPoint: .trailing))
    }
  }
}

@main
struct NativeControlsStyle: View {
  @State var name: String = "Ada"
  @State var choice: String = "b"
  @State var expanded: Bool = false

  var body: some View {
    VStack(spacing: 8) {
      TextField("Name", text: $name)
        .frame(width: 220)
        .padding(6)
        .background(Color("#202030"))
        .foregroundStyle(Color("#F0F0FF"))
        .cornerRadius(8)

      Picker("Choice", selection: $choice) {
        Text("Alpha").tag("a")
        Text("Beta").tag("b")
        Text("Disabled").tag("x").disabled(true)
      }
      .pickerStyle(.radioGroup)
      .frame(width: 220, height: 90)
      .padding(6)
      .background(Color("#101018"))
      .cornerRadius(7)

      Button("Toggle Detail") { expanded.toggle() }
        .padding(6)
        .background(LinearGradient(colors: [Color("#FF0000"), Color("#0000FF")], startPoint: .leading, endPoint: .trailing))
        .foregroundStyle(Color("#FFFFFF"))
        .cornerRadius(14)

      if expanded {
        ShapeStrip()
          .padding(4)
          .background(Color("#0C0D0E"))
          .cornerRadius(6)
      }

      Text(name)
        .padding(6)
        .background(Color("#111213"))
        .foregroundStyle(Color("#ABCDEF"))
        .cornerRadius(4)
    }
    .frame(width: 300, height: 360)
    .padding(12)
    .background(Color("#08090A"))
    .cornerRadius(20)
  }
}
