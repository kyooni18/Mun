struct ExpandingPanel: View {
  let expanded: boolean
  let compactWidth: number = 160
  let expandedWidth: number = 320

  var body: some View {
    RoundedRectangle(cornerRadius: 18)
      .fill(Color("#6750A4"))
      .frame(width: expanded ? expandedWidth : compactWidth, height: 96)
      .animation(.spring(response: 0.48, dampingFraction: 0.82), value: expanded)
  }
}

struct ToggleControl: View {
  @Binding var expanded: boolean

  var body: some View {
    Button("Toggle") { expanded.toggle() }
  }
}

struct NativeDemo: View {
  @State var expanded: boolean = false

  var body: some View {
    VStack(spacing: 16) {
      Text("Mün")
      ToggleControl(expanded: $expanded)
      ExpandingPanel(expanded: expanded)
      if expanded {
        Text("Expanded")
        Text("Native conditional branches are live")
      } else {
        Text("Collapsed")
      }
    }
    .padding(24)
  }
}

export default NativeDemo()
