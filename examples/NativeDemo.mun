const expanded = State(false)

struct ExpandingPanel: View {
  let expandedValue: boolean
  let compactWidth: number = 160
  let expandedWidth: number = 320

  var body: some View {
    Rectangle()
      .frame(width: expandedValue ? expandedWidth : compactWidth, height: 96)
      .background("#6750A4")
      .cornerRadius(18)
      .animation(Animation.spring(0.48, 0.82), expandedValue)
  }
}

struct NativeDemo: View {
  var body: some View {
    VStack(spacing: 16) {
      Text("Mün")
      Button("Toggle") { expanded.value = !expanded.value }
      ExpandingPanel(expandedValue: expanded.value)
      if (expanded.value) {
        Text("Expanded")
        Text("Native conditional branches are live")
      } else {
        Text("Collapsed")
      }
    }
    .padding(24)
  }
}

export default NativeDemo()
