{
  "name": "Vune",
  "scopeName": "source.vune",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#views" },
    { "include": "#html" },
    { "include": "#modifiers" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.vune", "match": "//.*$" },
        { "name": "comment.block.vune", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.vune", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.vune", "match": "\\\\." }] },
        { "name": "string.quoted.single.vune", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.vune", "match": "\\\\." }] },
        { "name": "string.template.vune", "begin": "`", "end": "`" }
      ]
    },
    "keywords": {
      "patterns": [{ "name": "keyword.control.vune", "match": "\\b(struct|var|let|init|if|else|for|in|true|false|nil)\\b" }, { "name": "storage.type.vune", "match": "\\b(View|State|Binding)\\b" }]
    },
    "views": {
      "patterns": [{ "name": "entity.name.type.view.vune", "match": "\\b[A-Z][A-Za-z0-9_$]*(?=\\s*\\()" }]
    },
    "html": {
      "patterns": [
        { "name": "comment.block.html.vune", "begin": "<!--", "end": "-->" },
        { "name": "entity.name.tag.html.vune", "match": "</?[A-Za-z][A-Za-z0-9:._-]*" },
        { "name": "entity.other.attribute-name.html.vune", "match": "\\b(?:class|for|aria-[A-Za-z0-9_-]+|data-[A-Za-z0-9_-]+|on[A-Za-z]+)(?=\\s*=|\\s|>)" },
        { "name": "string.quoted.double.html.vune", "begin": "\\\"", "end": "\\\"" },
        { "name": "string.quoted.single.html.vune", "begin": "'", "end": "'" }
      ]
    },
    "modifiers": {
      "patterns": [{ "name": "support.function.modifier.vune", "match": "\\.[a-zA-Z_$][A-Za-z0-9_$]*" }]
    },
    "labels": {
      "patterns": [{ "name": "entity.name.label.vune", "match": "\\b[a-zA-Z_$][A-Za-z0-9_$]*(?=\\s*:)" }]
    }
  }
}
