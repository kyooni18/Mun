{
  "name": "mun-language-support",
  "displayName": "Mün Language Support",
  "description": "Mün syntax and semantic highlighting, diagnostics, formatting, completion, hover, signature help, and language tooling.",
  "version": "0.1.20",
  "publisher": "mun",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyooni18/Mun"
  },
  "license": "MIT",
  "files": [
    "extension.cjs",
    "client.mjs",
    "discovery.mjs",
    "protocol.mjs",
    "language-configuration.json",
    "syntaxes",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mun"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "mun",
        "aliases": [
          "Mün",
          "Mun",
          "mun"
        ],
        "extensions": [
          ".mun"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mun",
        "scopeName": "source.mun",
        "path": "./syntaxes/mun.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mun.formatDocument",
        "title": "Mün: Format Document"
      }
    ],
    "configuration": {
      "title": "Mün",
      "properties": {
        "mun.server.command": {
          "type": "string",
          "default": "",
          "description": "Explicit mun executable. Otherwise use workspace-local @mun/ui before global mun; versions must match the extension."
        }
      }
    }
  }
}
