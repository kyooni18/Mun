{
  "name": "mun-language-support",
  "displayName": "Mün Language Support",
  "description": "Mün syntax and semantic highlighting, diagnostics, formatting, completion, hover, signature help, and language tooling.",
  "version": "0.1.0",
  "private": true,
  "publisher": "mun",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyooni18/Mun"
  },
  "license": "MIT",
  "files": [
    "extension.cjs",
    "language-configuration.json",
    "syntaxes",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mun",
    "onLanguage:vue"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "mun",
        "aliases": [
          "Mün",
          "Mun",
          "mun"
        ],
        "extensions": [
          ".mun"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mun",
        "scopeName": "source.mun",
        "path": "./syntaxes/mun.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mun.formatDocument",
        "title": "Mün: Format Document"
      }
    ],
    "configuration": {
      "title": "Mün",
      "properties": {
        "mun.languageTools.enableVue": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mün formatting, completion, hover, signature help, definition, diagnostics, rename, and semantic highlighting in Vue SFCs."
        }
      }
    }
  }
}
