{
  "name": "mun-language-support",
  "displayName": "Mün Language Support",
  "description": "Mün language tooling plus native dev, runtime inspection, diagnostics, and source navigation.",
  "version": "0.1.20",
  "publisher": "mun",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyooni18/Mun"
  },
  "license": "MIT",
  "files": [
    "extension.cjs",
    "client.mjs",
    "discovery.mjs",
    "dev-client.mjs",
    "protocol.mjs",
    "language-configuration.json",
    "syntaxes",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mun",
    "onCommand:mun.startDev",
    "onCommand:mun.stopDev",
    "onCommand:mun.restartDev",
    "onCommand:mun.inspectRunningApp",
    "onView:mun.runtimeView"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "mun",
        "aliases": [
          "Mün",
          "Mun",
          "mun"
        ],
        "extensions": [
          ".mun"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mun",
        "scopeName": "source.mun",
        "path": "./syntaxes/mun.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mun.formatDocument",
        "title": "Mün: Format Document"
      },
      {
        "command": "mun.startDev",
        "title": "Mün: Start Dev"
      },
      {
        "command": "mun.stopDev",
        "title": "Mün: Stop Dev"
      },
      {
        "command": "mun.restartDev",
        "title": "Mün: Restart App"
      },
      {
        "command": "mun.inspectRunningApp",
        "title": "Mün: Inspect Running App"
      }
    ],
    "configuration": {
      "title": "Mün",
      "properties": {
        "mun.server.command": {
          "type": "string",
          "default": "",
          "description": "Explicit mun executable. Otherwise use workspace-local @mun/ui before global mun; versions must match the extension."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "mun.runtimeView",
          "name": "Mün Runtime"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mun.startDev",
          "when": "view == mun.runtimeView",
          "group": "navigation@1"
        },
        {
          "command": "mun.inspectRunningApp",
          "when": "view == mun.runtimeView",
          "group": "navigation@2"
        },
        {
          "command": "mun.stopDev",
          "when": "view == mun.runtimeView",
          "group": "navigation@3"
        }
      ]
    }
  }
}
