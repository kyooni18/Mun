{
  "name": "@mun/web",
  "version": "0.1.20",
  "description": "Secondary DOM/HTML backend for Mün Semantic UI IR and compatibility View graphs.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./motion": {
      "types": "./dist/element-motion.d.ts",
      "import": "./dist/element-motion.js"
    },
    "./transition": {
      "types": "./dist/transition.d.ts",
      "import": "./dist/transition.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./lazy": {
      "types": "./dist/lazy-index.d.ts",
      "import": "./dist/lazy-index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@mun/animation": "workspace:*",
    "@mun/core": "workspace:*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
