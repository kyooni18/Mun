{
  "name": "@mun-ui/compiler",
  "version": "0.2.0",
  "description": "Compiler for canonical .mun source and Mün Semantic UI IR.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@mun-ui/animation": "workspace:*",
    "@mun-ui/core": "workspace:*",
    "@mun-ui/execution": "workspace:*",
    "typescript": "^5.9.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
