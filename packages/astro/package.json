{
  "name": "@mun/astro",
  "version": "0.1.20",
  "description": "First-class Astro renderer and embedded @mun integration for Mün.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@mun/compiler": "workspace:*",
    "@mun/core": "workspace:*",
    "@mun/vite": "workspace:*",
    "@mun/web": "workspace:*",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
