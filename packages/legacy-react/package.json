{
  "name": "@mun/legacy-react",
  "version": "0.1.20",
  "description": "Legacy React and compiler compatibility layer for Mün.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/legacy/index.js",
  "types": "./dist/legacy/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.js"
    },
    "./compiler": {
      "types": "./dist/legacy/compiler/index.d.ts",
      "import": "./dist/legacy/compiler/index.js"
    },
    "./experimental": {
      "types": "./dist/legacy/experimental.d.ts",
      "import": "./dist/legacy/experimental.js"
    },
    "./jsx-runtime": {
      "types": "./dist/legacy/jsx-runtime.d.ts",
      "import": "./dist/legacy/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/legacy/jsx-dev-runtime.d.ts",
      "import": "./dist/legacy/jsx-dev-runtime.js"
    },
    "./state": {
      "types": "./dist/legacy/state.d.ts",
      "import": "./dist/legacy/state.js"
    },
    "./types": {
      "types": "./dist/legacy/types.d.ts",
      "import": "./dist/legacy/types.js"
    },
    "./react-types": {
      "types": "./dist/legacy/react-types.d.ts",
      "import": "./dist/legacy/react-types.js"
    },
    "./vite": {
      "types": "./dist/legacy/vite.d.ts",
      "import": "./dist/legacy/vite.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@mun/core": "workspace:*",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
