{
  "name": "@mun/core",
  "version": "0.1.20",
  "description": "Backend-neutral Mün semantics, motion values, and Semantic UI IR.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./swiftui-manifest": {
      "types": "./dist/api-manifest.d.ts",
      "import": "./dist/api-manifest.js"
    },
    "./internal/motion-abi": {
      "types": "./dist/motion-abi.d.ts",
      "import": "./dist/motion-abi.js"
    },
    "./internal/runtime": {
      "types": "./dist/internal-runtime.d.ts",
      "import": "./dist/internal-runtime.js"
    },
    "./internal/execution": {
      "types": "./dist/resident-execution.d.ts",
      "import": "./dist/resident-execution.js"
    },
    "./web-primitives": {
      "types": "./dist/web-primitives.d.ts",
      "import": "./dist/web-primitives.js"
    },
    "./corners": {
      "types": "./dist/corners.d.ts",
      "import": "./dist/corners.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@mun/execution": "workspace:*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
